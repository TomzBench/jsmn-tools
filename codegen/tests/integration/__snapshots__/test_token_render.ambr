# name: test_render_token_generated_impl
  '''
  static const struct jt_token jsmn_token_web_claims = {
      .header     = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
      .header_len = 36,
      .alg        = JT_ALG_HS256,
      .mac_len    = 32,
      .claims     = JSMN_WEB_CLAIMS_KEY,
      .claims_len = JSMN_WEB_CLAIMS_LEN,
  };
  
  int32_t
  jsmn_token_sign_web_claims(
      char *dst,
      uint32_t dlen,
      const struct web_claims *claims,
      const struct jt_key *key)
  {
      uint8_t scratch[JSMN_WEB_CLAIMS_LEN];
      return jt_token_sign(
          &jsmn_schemas, &jsmn_token_web_claims, dst, dlen, claims, key, scratch);
  }
  
  int32_t
  jsmn_token_verify_web_claims(
      struct web_claims *dst,
      const char *tok,
      uint32_t tlen,
      const struct jt_key *key,
      uint32_t now)
  {
      uint8_t scratch[JSMN_WEB_CLAIMS_LEN];
      jsmntok_t toks[JSMN_WEB_CLAIMS_NTOKS];
      int32_t n = jt_token_verify(
          &jsmn_schemas, &jsmn_token_web_claims, dst, tok, tlen, key, scratch,
          toks, JSMN_WEB_CLAIMS_NTOKS);
      if (n < 0) return n;
      if ((int64_t)now >= (int64_t)dst->exp) return JT_ERR_TOKEN_EXPIRED;
      return n;
  }
